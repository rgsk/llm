{
    // this project's venv, not one inherited from another workspace
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    // Testing panel + run buttons in the gutter
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests",
        // don't swallow print() from passing tests
        "-rP"
    ],
    // format + sort imports on save with ruffgrid (Ruff with grids: a bracket whose first line holds
    // several items stays packed), running .venv's ruff; no Ruff warnings in the editor
    "ruff.lint.enable": false,
    "[python]": {
        "editor.defaultFormatter": "rgsk.ruffgrid",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "never",
            "source.organizeImports.ruff": "explicit"
        }
    },
    // the same for notebooks, whole-notebook (an import used in a later cell stays), whatever the
    // first cell is: ruffgrid asks on the first code cell
    "notebook.defaultFormatter": "rgsk.ruffgrid",
    "notebook.formatOnSave.enabled": true,
    "notebook.codeActionsOnSave": {
        "notebook.source.fixAll": "never",
        "notebook.source.organizeImports": "explicit"
    }
}